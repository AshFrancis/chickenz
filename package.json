{
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev:client": "pnpm --filter @chickenz/client dev",
    "dev:server": "pnpm --filter @chickenz/server dev",
    "build": "pnpm build:wasm && pnpm --filter @chickenz/client build",
    "start": "bun services/server/src/index.ts",
    "test": "bun test packages/sim && bun test ./services/server/src/",
    "test:sim": "bun test packages/sim",
    "test:server": "bun test ./services/server/src/",
    "test:rust": "cd services/prover/core && cargo test",
    "test:coverage": "bun test --coverage ./services/server/src/ ./packages/sim/",
    "typecheck": "tsc -b packages/sim && tsc --noEmit -p apps/client && bun build services/server/src/index.ts --outdir /tmp/chickenz-typecheck --target bun",
    "build:wasm": "cd services/prover/wasm && wasm-pack build --target web",
    "lint": "eslint packages/sim/src apps/client/src services/server/src",
    "lint:fix": "eslint --fix packages/sim/src apps/client/src services/server/src",
    "lint:docs": "markdownlint-cli2 '**/*.md' '!node_modules' '!**/node_modules' '!**/target' '!**/pkg'",
    "format": "prettier --write 'packages/sim/src/**/*.ts' 'apps/client/src/**/*.ts' 'services/server/src/**/*.ts' '*.json'",
    "format:check": "prettier --check 'packages/sim/src/**/*.ts' 'apps/client/src/**/*.ts' 'services/server/src/**/*.ts' '*.json'",
    "audit:security": "pnpm audit",
    "check:all": "pnpm typecheck && pnpm lint && pnpm lint:docs && pnpm format:check && pnpm test && pnpm build"
  },
  "pnpm": {
    "overrides": {
      "rollup": ">=4.59.0",
      "flatted": ">=3.4.2",
      "picomatch": ">=4.0.4",
      "smol-toml": ">=1.6.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "markdownlint-cli2": "^0.22.0",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.0"
  }
}
