# ═══════════════════════════════════════════════════════════════
# Chickenz — Environment Variables
#
# Copy to .env and fill in values:  cp .env.example .env
#
# For LOCAL DEV, no variables are required. The game runs fully
# without ZK proving or blockchain integration. Variables below
# are only needed for specific production features.
# ═══════════════════════════════════════════════════════════════


# ── Server (OPTIONAL) ────────────────────────────────────────
# Basic server configuration. Defaults work for local dev.

# Port for the game server (HTTP + WebSocket)
# OPTIONAL — defaults to 3000
PORT=3000

# CORS origin restriction
# OPTIONAL — defaults to "*" (all origins). Set in production.
# CORS_ORIGIN=https://chickenz.io

# Region identifier and canonical hostname (multi-region deployments)
# OPTIONAL — only needed when running multiple regional servers
# SERVER_REGION=us
# CANONICAL_HOST=us.chickenz.io


# ── Smart Account Kit / Passkey Wallets (REQUIRED for wallet creation) ──
# Shared testnet infrastructure from Kalepail's deployment.
# These rarely change. See: https://github.com/kalepail/smart-account-kit
# Without these, passkey wallet creation will not work.

# REQUIRED for passkey wallet creation
VITE_ACCOUNT_WASM_HASH=a12e8fa9621efd20315753bd4007d974390e31fbcb4a7ddc4dd0a0dec728bf2e
VITE_WEBAUTHN_VERIFIER=CBSHV66WG7UV6FQVUTB67P3DZUEJ2KJ5X6JKQH5MFRAAFNFJUAJVXJYV

# OZ Channels managed relayer (sponsors wallet creation fees on testnet)
# REQUIRED for passkey wallet creation — generate key at https://channels.openzeppelin.com/testnet/gen
VITE_RELAYER_URL=https://channels.openzeppelin.com/testnet/YOUR_API_KEY


# ── Stellar / Soroban (REQUIRED for ranked play + on-chain settlement) ──
# Without these, ranked mode and on-chain match registration are disabled.

# REQUIRED for ranked — Stellar admin key for start_game/end_game transactions
# Generate a keypair: stellar keys generate default --network testnet
STELLAR_ADMIN_SECRET=S_your_stellar_secret_here

# OPTIONAL — Soroban RPC endpoint, defaults to testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# OPTIONAL — Chickenz game contract address. Must match client's CHICKENZ_CONTRACT.
CHICKENZ_CONTRACT=CBRDPRKUK3NH2HXOWSNZPG2ZSXXXZBR7GCMN7WLHWINMLNDCJ7NSREKG


# ── Boundless ZK Proving (OPTIONAL — remote Groth16 proving) ────────────
# Only needed if using the Boundless marketplace for proof generation.
# Without these, proofs must be generated locally or via the worker.

# REQUIRED for Boundless — Ethereum RPC (Base mainnet)
# Fund wallet with Base ETH
BOUNDLESS_RPC_URL=https://mainnet.base.org

# REQUIRED for Boundless — Ethereum wallet private key (0x-prefixed)
BOUNDLESS_PRIVATE_KEY=0x_your_base_private_key

# REQUIRED for Boundless — Pinata JWT for IPFS uploads (ELF + input storage)
# Also used to pin match transcripts for immutable data availability
# Get token at https://pinata.cloud
PINATA_JWT=your_pinata_jwt_token


# ── Proof Worker (OPTIONAL — remote proof worker authentication) ────────
# Only needed if using a remote machine (e.g. gaming PC) to generate proofs.

# REQUIRED for worker — set to any random string; workers must send the same key
WORKER_API_KEY=your_random_api_key


# ── Prover Binary (OPTIONAL — local Boundless proving from server) ──────
# Only needed if running Boundless proving directly from the server process.

# OPTIONAL — path to chickenz-host binary
PROVER_BINARY=../../services/prover/target/release/chickenz-host


# ── Dev Mode (OPTIONAL — testing only) ──────────────────────────────────
# Enables instant fake proofs with no real ZK proving. Never use in production.

# OPTIONAL — set to 1 for dev mode fake proofs
# RISC0_DEV_MODE=1
