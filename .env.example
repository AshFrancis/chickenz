# ── Server ────────────────────────────────────────────────────
# Port for the game server (HTTP + WebSocket)
PORT=3000

# CORS origin restriction (default: "*" allows all origins)
# CORS_ORIGIN=https://chickenz.io

# ── Stellar / Soroban (Testnet) ───────────────────────────────
# Required for on-chain match registration and settlement.
# Generate a keypair: stellar keys generate default --network testnet
STELLAR_ADMIN_SECRET=S_your_stellar_secret_here
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── Boundless ZK Proving (Optional) ──────────────────────────
# Required for Boundless remote proving (Groth16 via marketplace).
# PINATA_JWT is also used to pin match transcripts to IPFS for immutable data availability.
# Fund wallet with Ethereum Sepolia ETH. Get Pinata JWT at https://pinata.cloud
BOUNDLESS_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BOUNDLESS_PRIVATE_KEY=0x_your_sepolia_private_key
PINATA_JWT=your_pinata_jwt_token

# ── Proof Worker (Optional) ──────────────────────────────────
# API key for authenticating remote proof workers (gaming PC).
# Set to any random string; workers must send the same key.
WORKER_API_KEY=your_random_api_key

# ── Prover Binary (Optional) ─────────────────────────────────
# Path to chickenz-host binary for local Boundless proving.
# Only needed if running Boundless proving from the server itself.
PROVER_BINARY=../../services/prover/target/release/chickenz-host

# ── Dev Mode (Optional) ──────────────────────────────────────
# Set to 1 for instant fake proofs (no real ZK proving).
# RISC0_DEV_MODE=1
